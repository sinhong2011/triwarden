    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@wxt-dev/module-solid": "1.1.4",
    "solid-js": "1.9.17",
    "typescript": "7.0.2",
    "wxt": "0.21.5"
  }
}
