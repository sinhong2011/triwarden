---
/** Everyday Mac integration: Auto-Type and the menu bar. Developer features (API keys, SSH agent, tw) are in Developers.astro. */
import SectionHead from "./SectionHead.astro";
import Shot from "./Shot.astro";
import { m } from "../paraglide/messages.js";

// Auto-type keys, as the app binds them (README: ↵ fills, ⌃↵ username, ⌥↵ password, ⇧ also submits; ⌥⌘\ fills
// the page or app you're in from anywhere).
const keys: [string[], string][] = [
  [["↵"], m.kt_both()],
  [["⌃", "↵"], m.kt_user()],
  [["⌥", "↵"], m.kt_pass()],
  [["⇧"], m.kt_submit()],
  [["⌥", "⌘", "\\"], m.kt_global()],
];
---
<section class="mx-auto max-w-(--max) px-(--gutter) py-[clamp(64px,8vw,112px)]">
  <SectionHead kicker={m.mac_kicker()}>
    <h2>{m.mac_title_1()}<br /><em>{m.mac_title_2()}</em></h2>
  </SectionHead>
  <ol class="mt-[clamp(32px,4.5vw,60px)] list-none border-t border-line-2 p-0">
    <li class="row" data-row>
      <span class="row__no">01</span>
      <div class="row__text">
        <p class="kicker mb-3!">{m.row_autotype_kicker()}</p>
        <h3>{m.row_autotype_title()}</h3>
        <p set:html={m.row_autotype_body({ shortcut: "<kbd>⌥⌘\\</kbd>" })} />
      </div>
      <div class="row__demo keys" role="group" aria-label={m.kt_legend()}>
        {keys.map(([combo, label], i) => (
          <div class:list={["keys__row", i === keys.length - 1 && "keys__row--global"]}>
            <span class="keys__combo">{combo.map((k) => <kbd>{k}</kbd>)}</span>
            <span class="keys__label">{label}</span>
          </div>
        ))}
      </div>
    </li>
    <li class="row" data-row>
      <span class="row__no">02</span>
      <div class="row__text">
        <p class="kicker mb-3!">{m.row_menubar_kicker()}</p>
        <h3>{m.row_menubar_title()}</h3>
        <p>{m.row_menubar_body()}</p>
      </div>
      <div class="row__demo grid place-items-center">
        <div class="w-[min(100%,300px)]"><Shot name="menubar" alt={m.alt_menubar()} class="w-full h-auto" /></div>
      </div>
    </li>
  </ol>
</section>

<script>import "../scripts/rows";</script>
