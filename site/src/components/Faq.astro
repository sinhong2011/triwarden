---
import SectionHead from "./SectionHead.astro";
import { SITE } from "../config";
import { m } from "../paraglide/messages.js";
const t = m as unknown as Record<string, (p?: Record<string, string>) => string>;
const faqs = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => [t[`faq${n}_q`](), t[`faq${n}_a`]({ price: SITE.price, email: SITE.supportEmail })]);
---
<section id="faq" class="mx-auto grid max-w-(--max) gap-[6vw] px-(--gutter) py-[clamp(64px,8vw,112px)] lg:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)]">
  <SectionHead kicker={m.faq_kicker()}>
    <h2>{m.faq_title_1()}<br /><em>{m.faq_title_2()}</em></h2>
  </SectionHead>
  <div class="border-t border-line-2">
    {faqs.map(([q, a]) => (
      <details class="faq group border-b border-line-2">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[clamp(18px,1.6vw,21px)] font-medium [&::-webkit-details-marker]:hidden">
          {q}
          <span aria-hidden="true" class="relative size-4 shrink-0 before:absolute before:inset-x-0 before:top-1/2 before:h-[1.5px] before:-translate-y-1/2 before:bg-ink after:absolute after:inset-y-0 after:left-1/2 after:w-[1.5px] after:-translate-x-1/2 after:bg-ink after:transition-transform after:duration-500 after:ease-(--ease-expo) group-open:after:scale-y-0"></span>
        </summary>
        <div data-faq-body><p class="m-0 max-w-[620px] pb-6 text-[16.5px] text-ink-2">{a}</p></div>
      </details>
    ))}
  </div>
</section>
